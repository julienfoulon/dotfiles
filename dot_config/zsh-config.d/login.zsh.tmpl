if [[ -o login ]]; then
    # ---- host banner: figlet "<hostname>[.lab]" in this host's color ----
    # Color comes from .chezmoidata/banner.yaml (templated at apply time). figlet
    # is installed via .chezmoidata/packages.yaml; the '3d' font (xero, no redist
    # license) is fetched to ~/.local/share/figlet by run_onchange_install-figlet-
    # fonts.sh. ".lab" is appended on lab hosts (non-laptops). Falls back to the
    # default figlet font, then to plain text, if the font/binary is missing.
    banner_name="{{ .chezmoi.hostname }}{{ if not .laptop }}.lab{{ end }}"
    banner_color="{{ index .bannerColors .chezmoi.hostname | default "white" }}"
    banner_font="${XDG_DATA_HOME:-$HOME/.local/share}/figlet/3d.flf"
    if (( $+commands[figlet] )); then
        print -Pn "%F{${banner_color}}"
        if [[ -r "$banner_font" ]]; then
            figlet -f "$banner_font" -- "$banner_name"
        else
            figlet -- "$banner_name"
        fi
        print -Pn "%f"
    else
        print -P "%F{${banner_color}}${banner_name}%f"
    fi

    os_id="unknown"
    os_version="unknown"
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        os_id="${ID:-unknown}"
        os_version="${VERSION_ID:-unknown}"
    fi

    host_name="${HOST%%.*}"
    if [[ -z "$host_name" && -r /etc/hostname ]]; then
        IFS= read -r host_name < /etc/hostname
    fi
    host_name="${host_name:-unknown}"

    kernel_version="unknown"
    if (( $+commands[uname] )); then
        kernel_version="$(uname -r)"
    fi
    container_tag=""
    if [[ -r /run/systemd/container ]]; then
        IFS= read -r container_type < /run/systemd/container
        container_tag=" %F{blue}(container:${container_type})%f"
    fi

    os_icon=""
    os_label="$os_id"
    case "$os_id" in
        ubuntu) os_icon=""; os_label="Ubuntu" ;;
        arch) os_icon=""; os_label="Arch" ;;
        debian) os_icon=""; os_label="Debian" ;;
        fedora) os_icon=""; os_label="Fedora" ;;
    esac

    print -P "%F{cyan}%f %BWelcome%f %B${USER}%b - %F{yellow}󰒋%f ${host_name}${container_tag}, %F{green}${os_icon}%f ${os_label} ${os_version}, %F{magenta}%f ${kernel_version}"
fi
