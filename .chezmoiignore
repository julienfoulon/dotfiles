# The hyprland skill (a Wayland WM helper) is only useful where Hyprland runs.
# Gate it on the same `laptop` flag that gates GUI packages, so it is not
# deployed on non-laptop hosts (nspawn containers, servers).
# hasKey guard: during a first-run `chezmoi init --apply` the config data is
# not loaded yet; treat that as non-laptop (the skill lands on the next apply).
{{ if not (and (hasKey .chezmoi.config.data "laptop") .chezmoi.config.data.laptop) }}
.claude/skills/hyprland
.local/share/agent-skills/hyprland
{{ end }}
